{
 "id": "anime-cinematic",
 "name": "Anime-Inspired Cinematic",
 "palette": {
  "bg": "#101828",
  "ink": "#F4F7FF",
  "accent": "#8FC7FF",
  "sub": "#B9C8E4"
 },
 "fonts": {
  "display": "CormorantGaramond.ttf",
  "script": "GreatVibes.ttf",
