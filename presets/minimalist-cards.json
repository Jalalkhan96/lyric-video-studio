{
 "id": "minimalist-cards",
 "name": "Clean Minimalist Lyric Cards",
 "palette": {
  "bg": "#FFFFFF",
  "ink": "#1C1C1E",
  "accent": "#B22234",
  "sub": "#6E6E73"
 },
 "fonts": {
  "display": "Montserrat.ttf",
  "script": "Montserrat.ttf",
  "body": "Montserrat.ttf"
 },
